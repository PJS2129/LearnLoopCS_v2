rules_version = '2';

// LearnLoopCS Firestore 보안 규칙 (2-3단계: 학습 이력 및 연습 문제 기록 격리 저장)
// 기본은 전부 차단이고, 아래에 명시한 경로만 허용한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자: admins/{이메일(소문자)} 문서가 있으면 관리자.
    // 문서는 Firebase 콘솔에서만 만든다 (클라이언트 쓰기 차단).
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // 학생 문서 형식 검증. 분반 목록은 src/app/config.ts의 sections와 같게 유지한다.
    function validStudent(d) {
      return d.keys().hasOnly(['studentId', 'name', 'section', 'email', 'createdAt'])
        && d.keys().hasAll(['studentId', 'name', 'section', 'email', 'createdAt'])
        && d.studentId is string && d.studentId.matches('^[0-9]{4,12}$')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.section in ['A반', 'B반']
        && d.email is string
        && d.createdAt is timestamp;
    }

    // 학습 요약 문서 형식 검증
    function validSummary(d) {
      return d.keys().hasOnly(['timeByTab', 'quizzes', 'totalFirstAttempts', 'correctFirstAttempts', 'updatedAt'])
        && d.keys().hasAll(['timeByTab', 'quizzes', 'totalFirstAttempts', 'correctFirstAttempts', 'updatedAt'])
        && d.timeByTab is map
        && d.quizzes is map
        && d.totalFirstAttempts is number && d.totalFirstAttempts >= 0
        && d.correctFirstAttempts is number && d.correctFirstAttempts >= 0
        && d.updatedAt is timestamp;
    }

    // 연습 문제 풀이 기록 형식 검증
    function validPracticeResult(d) {
      return d.keys().hasOnly(['quizId', 'tabId', 'selectedOption', 'isCorrect', 'attemptNumber', 'isFirstAttempt', 'createdAt'])
        && d.keys().hasAll(['quizId', 'tabId', 'selectedOption', 'isCorrect', 'attemptNumber', 'isFirstAttempt', 'createdAt'])
        && d.quizId is string && d.quizId.size() > 0 && d.quizId.size() <= 100
        && d.tabId is string && d.tabId.size() > 0 && d.tabId.size() <= 50
        && d.selectedOption is number && d.selectedOption >= 0 && d.selectedOption <= 10
        && d.isCorrect is bool
        && d.attemptNumber is number && d.attemptNumber >= 1
        && d.isFirstAttempt is bool
        && d.createdAt is timestamp;
    }

    // 활동 로그 형식 검증
    function validLearningLog(d) {
      return d.keys().hasOnly(['tabId', 'tabName', 'activity', 'detail', 'duration', 'timestamp'])
        && d.keys().hasAll(['tabId', 'tabName', 'activity', 'detail', 'duration', 'timestamp'])
        && d.tabId is string && d.tabId.size() > 0 && d.tabId.size() <= 50
        && d.tabName is string && d.tabName.size() > 0 && d.tabName.size() <= 50
        && d.activity is string && d.activity.size() > 0 && d.activity.size() <= 100
        && d.detail is string && d.detail.size() <= 200
        && d.duration is number && d.duration >= 0
        && d.timestamp is timestamp;
    }


    match /admins/{email} {
      // 본인 이메일 문서만 읽을 수 있다 (관리자 여부 확인용). 쓰기는 전부 차단.
      allow get: if isSignedIn() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    match /students/{uid} {
      // 읽기: 본인 또는 관리자
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // 최초 등록: 본인만, 문서가 없을 때만(create), 이메일은 로그인 계정과 일치해야 함
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && validStudent(request.resource.data)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;

      // 수정: 학생 본인은 불가, 관리자만 가능 (학번 오입력 정정용).
      // 이메일·등록 시각은 바꿀 수 없다.
      allow update: if isAdmin()
        && validStudent(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      // --- [2-3단계 추가] 학습 이력 및 연습 문제 기록 격리 저장 ---

      // 1. 학습 요약 집계 문서 (timeByTab, 첫 시도 정답률 등)
      // 본인 읽기 또는 관리자 읽기, 본인만 생성/수정 가능 (삭제 금지)
      match /learning_stats/summary {
        allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && validSummary(request.resource.data);
        allow delete: if false;
      }

      // 2. 연습 문제 풀이 기록 (첫 시도 및 다시 풀기 시도 히스토리)
      // 본인 또는 관리자 읽기, 본인 생성(create)만 허용 (수정·삭제 일체 금지)
      match /practice_results/{resultId} {
        allow get, list: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && validPracticeResult(request.resource.data);
        allow update, delete: if false;
      }

      // 3. 활동 로그 내역 (최근 활동 타임라인)
      // 본인 또는 관리자 읽기, 본인 생성(create)만 허용 (수정·삭제 일체 금지)
      match /learning_logs/{logId} {
        allow get, list: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && validLearningLog(request.resource.data);
        allow update, delete: if false;
      }
    }

    // 시험 정보 공개 문서 형식 검증 (4-1단계: finalizedBy는 학생 노출 방지를 위해 private/config로 분리, 기존 문서 호환을 위해 선택적 허용)
    function validExamInfo(d) {
      return d.keys().hasAll(['examId', 'examName', 'status', 'questionCount', 'domainCounts', 'finalizedAt'])
        && d.keys().hasOnly(['examId', 'examName', 'status', 'questionCount', 'domainCounts', 'finalizedAt', 'finalizedBy', 'examDate', 'startAt', 'durationMinutes', 'bufferMinutes', 'closeAt', 'updatedAt'])
        && d.examId is string && d.examId.size() > 0 && d.examId.size() <= 100
        && d.examName is string && d.examName.size() > 0 && d.examName.size() <= 100
        && d.status in ['finalized', 'ready', 'open', 'closed']
        && d.questionCount is number && d.questionCount >= 1
        && d.domainCounts is map
        && d.finalizedAt is timestamp;
    }

    // 학생용 시험 문항 문서 형식 검증 (3-2단계: no, domain, level, question, choices 외 필드 불허)
    function validExamQuestion(d) {
      return d.keys().hasOnly(['no', 'domain', 'level', 'question', 'choices'])
        && d.keys().hasAll(['no', 'domain', 'level', 'question', 'choices'])
        && d.no is number && d.no >= 1
        && d.domain in ['기초 ICT', '하드웨어·CPU', '데이터 표현', '논리회로', '자료구조·알고리즘']
        && d.level in ['상', '중', '하']
        && d.question is string && d.question.size() > 0
        && d.choices is list && d.choices.size() == 4;
    }

    // 학생 응시 세션 문서 형식 검증 (4-1단계: studentId, name, section 위조 방지 및 서버 시각 강제)
    function validExamSession(d, studentData) {
      return d.keys().hasOnly(['uid', 'studentId', 'name', 'section', 'enteredCode', 'enteredAt'])
        && d.keys().hasAll(['uid', 'studentId', 'name', 'section', 'enteredCode', 'enteredAt'])
        && d.uid == request.auth.uid
        && d.studentId == studentData.studentId
        && d.name == studentData.name
        && d.section == studentData.section
        && d.enteredAt == request.time;
    }

    // 보조 기록 세션 요약 갱신 형식 검증 (6단계: 핵심 필드 불변, 카운터/시간 단조 증가, cameraUsed 1회 확정)
    function validProctorUpdate(rData, prevData) {
      let allowedKeys = ['uid', 'studentId', 'name', 'section', 'enteredCode', 'enteredAt', 'tabBlurCount', 'tabBlurDuration', 'faceOutCount', 'faceOutDuration', 'multipleFacesCount', 'cameraUsed', 'lastProctorAt'];
      let unchangedCore = rData.uid == prevData.uid
        && rData.studentId == prevData.studentId
        && rData.name == prevData.name
        && rData.section == prevData.section
        && rData.enteredCode == prevData.enteredCode
        && rData.enteredAt == prevData.enteredAt;

      let validTabCount = (!('tabBlurCount' in rData) && !('tabBlurCount' in prevData)) ||
        (('tabBlurCount' in rData) && rData.tabBlurCount is number && (!('tabBlurCount' in prevData) || rData.tabBlurCount >= prevData.tabBlurCount));
      let validTabDur = (!('tabBlurDuration' in rData) && !('tabBlurDuration' in prevData)) ||
        (('tabBlurDuration' in rData) && rData.tabBlurDuration is number && (!('tabBlurDuration' in prevData) || rData.tabBlurDuration >= prevData.tabBlurDuration));
      let validFaceCount = (!('faceOutCount' in rData) && !('faceOutCount' in prevData)) ||
        (('faceOutCount' in rData) && rData.faceOutCount is number && (!('faceOutCount' in prevData) || rData.faceOutCount >= prevData.faceOutCount));
      let validFaceDur = (!('faceOutDuration' in rData) && !('faceOutDuration' in prevData)) ||
        (('faceOutDuration' in rData) && rData.faceOutDuration is number && (!('faceOutDuration' in prevData) || rData.faceOutDuration >= prevData.faceOutDuration));
      let validMultiCount = (!('multipleFacesCount' in rData) && !('multipleFacesCount' in prevData)) ||
        (('multipleFacesCount' in rData) && rData.multipleFacesCount is number && (!('multipleFacesCount' in prevData) || rData.multipleFacesCount >= prevData.multipleFacesCount));
      let validCamera = (!('cameraUsed' in rData) && !('cameraUsed' in prevData)) ||
        (('cameraUsed' in rData) && rData.cameraUsed is bool && (!('cameraUsed' in prevData) || rData.cameraUsed == prevData.cameraUsed));

      return rData.keys().hasOnly(allowedKeys)
        && unchangedCore
        && validTabCount
        && validTabDur
        && validFaceCount
        && validFaceDur
        && validMultiCount
        && validCamera;
    }

    // 개별 보조 기록(proctorLogs) 문서 형식 검증 (6단계)
    function validProctorLog(d) {
      return d.keys().hasOnly(['id', 'type', 'startAt', 'endAt', 'durationSeconds', 'detail', 'createdAt'])
        && d.keys().hasAll(['id', 'type', 'startAt', 'endAt', 'durationSeconds', 'detail', 'createdAt'])
        && d.id is string
        && d.type in ['tab_blur', 'face_out', 'multiple_faces']
        && d.startAt is string
        && d.endAt is string
        && d.durationSeconds is number && d.durationSeconds >= 0
        && d.detail is string
        && d.createdAt == request.time;
    }

    // 학생 답안 제출 접수 확인 문서 형식 검증 (4-2단계)
    function validExamSubmission(d) {
      return d.keys().hasOnly(['uid', 'receiptId', 'submittedAt', 'submitType'])
        && d.keys().hasAll(['uid', 'receiptId', 'submittedAt', 'submitType'])
        && d.uid == request.auth.uid
        && d.receiptId is string && d.receiptId.size() > 0 && d.receiptId.size() <= 100
        && d.submittedAt is timestamp
        && d.submitType in ['manual', 'auto', 'delayed'];
    }

    // --- [4-1단계/4-2단계] 시험 정보, 비공개 설정, 세션, 접수 및 학생용 문항 격리 ---
    match /exams/{examId} {
      // 시험 기본 메타데이터: 로그인한 사용자(학생/관리자) 읽기 가능
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if isAdmin() && validExamInfo(request.resource.data);
      // [4-3단계 A안] 시험 상태가 open인 동안에는 제한시간(durationMinutes), 여유시간(bufferMinutes), 마감시각(closeAt) 수정 불가
      allow update: if isAdmin() && validExamInfo(request.resource.data)
        && (
          resource.data.status != 'open'
          || (
            request.resource.data.durationMinutes == resource.data.durationMinutes
            && request.resource.data.bufferMinutes == resource.data.bufferMinutes
            && request.resource.data.closeAt == resource.data.closeAt
          )
        );
      allow delete: if isAdmin();

      // 비공개 관리자 설정 (시험 코드, finalizedBy 이메일 등): 관리자만 읽고 쓰기
      match /private/{docId} {
        allow read, write: if isAdmin();
      }

      // 학생 응시 세션 문서: 본인 학생이 올바른 코드로 오픈 상태일 때만 1회 생성
      match /sessions/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/exams/$(examId)).data.status == 'open'
          && exists(/databases/$(database)/documents/students/$(uid))
          && exists(/databases/$(database)/documents/exams/$(examId)/private/config)
          && request.resource.data.enteredCode == get(/databases/$(database)/documents/exams/$(examId)/private/config).data.accessCode
          && validExamSession(request.resource.data, get(/databases/$(database)/documents/students/$(uid)).data);
        // [6단계 추가] 보조 기록 요약 필드 갱신 (제출 전, 본인 학생, 증가만 허용)
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/exams/$(examId)/submissions/$(uid))
          && validProctorUpdate(request.resource.data, resource.data);
        allow delete: if isAdmin();

        // [6단계 추가] 학생별 개별 보조 기록 하위 컬렉션
        match /proctorLogs/{logId} {
          allow get, list: if request.auth != null && (request.auth.uid == uid || isAdmin());
          allow create: if isSignedIn()
            && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/exams/$(examId)/submissions/$(uid))
            && validProctorLog(request.resource.data);
          allow update: if false; // 학생이 자신의 기록을 조작·수정할 수 없음
          allow delete: if isAdmin(); // 관리자 리셋 시에만 삭제 가능
        }
      }

      // [4-2단계] 학생 답안 접수 확인 문서:
      // 본인 학생 또는 관리자 읽기 허용, 세션이 존재하는 본인 학생이 1회 생성(create)만 허용 (수정·삭제 금지)
      match /submissions/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/exams/$(examId)/sessions/$(uid))
          && validExamSubmission(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // 학생용 문항 하위 컬렉션:
      // 관리자이거나, 세션이 존재하고 시험이 open이며 아직 제출하지 않은 학생 열람 허용
      match /questions/{no} {
        allow get, list: if isAdmin() || (
          request.auth != null
          && exists(/databases/$(database)/documents/exams/$(examId)/sessions/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/exams/$(examId)/submissions/$(request.auth.uid))
          && get(/databases/$(database)/documents/exams/$(examId)).data.status == 'open'
        );
        allow create, update: if isAdmin() && validExamQuestion(request.resource.data);
        allow delete: if isAdmin();
      }
    }
  }
}

